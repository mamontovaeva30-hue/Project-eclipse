    }, 1400);
});


// ВХОД В СИСТЕМУ
function login() {
    const enteredId = agentId.value.trim();
    const enteredPassword = agentPassword.value;

    if (
        enteredId === ACCESS_ID &&
        enteredPassword === ACCESS_PASSWORD
    ) {
        loginError.textContent = "";

        loginScreen.classList.add("hidden");
        mainApp.classList.remove("hidden");

        showToast("Доступ подтверждён. Добро пожаловать, агент 1047.");

        openPage("dashboard");
    } else {
        loginError.textContent =
            "ОШИБКА: неверный идентификатор или код доступа.";
    }
}

loginButton.addEventListener("click", login);


// ВХОД ПО КЛАВИШЕ ENTER
agentPassword.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
        login();
    }
});

agentId.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
        agentPassword.focus();
    }
});


// ВЫХОД ИЗ СИСТЕМЫ
logoutButton.addEventListener("click", () => {
    mainApp.classList.add("hidden");
